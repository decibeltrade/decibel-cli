{
  "bin": {
    "decibel-cli": "./bin/decibel-cli.js",
    "decibel-mcp": "./bin/decibel-mcp.js"
  },
  "dependencies": {
    "@aptos-labs/gas-station-client": "^2.0.3",
    "@aptos-labs/ts-sdk": "^5.2.1",
    "@decibeltrade/sdk": "0.6.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "better-sqlite3": "^11.0.0",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "ethers": "^6.0.0",
    "inquirer": "^9.2.23",
    "isomorphic-ws": "^5.0.0",
    "tsx": "^4.21.0",
    "ws": "^8.18.1",
    "zod": "^3.25.62"
  },
  "description": "Command-line interface for trading on Decibel",
  "devDependencies": {
    "@decibeltrade/eslint-config": "1.0.0",
    "@decibeltrade/tsconfig": "1.0.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.28.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "dist/index.js",
  "name": "@decibeltrade/cli",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
