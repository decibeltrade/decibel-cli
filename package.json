{
  "name": "decibel-cli",
  "version": "1.0.0",
  "description": "Command-line interface for trading on Decibel DEX",
  "type": "module",
  "bin": {
    "decibel-cli": "./dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git@github.com:decibeltrade/decibel-cli.git"
  },
  "keywords": [
    "decibel",
    "dex",
    "trading",
    "cli",
    "aptos",
    "perpetuals"
  ],
  "author": "Decibel Trade",
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "tsx dist/index.js",
    "start:mcp": "tsx dist/mcp-server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --fix --max-warnings 0",
    "lint:check": "eslint src --max-warnings 0",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@aptos-labs/gas-station-client": "^2.0.3",
    "@aptos-labs/ts-sdk": "^5.2.1",
    "@decibeltrade/sdk": "^0.3.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "better-sqlite3": "^11.0.0",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "ink": "^5.0.1",
    "ink-spinner": "^5.0.0",
    "inquirer": "^9.2.23",
    "isomorphic-ws": "^5.0.0",
    "ora": "^8.0.1",
    "react": "^18.3.1",
    "ws": "^8.18.1",
    "zod": "^3.25.62"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.3",
    "@types/ws": "^8.18.0",
    "eslint": "^9.28.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
