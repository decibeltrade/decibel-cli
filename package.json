  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src --fix --max-warnings 0",
    "lint:check": "eslint src --max-warnings 0",
    "prepublishOnly": "npm run build",
    "start": "tsx dist/index.js",
    "start:mcp": "tsx dist/mcp-server.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "version": "0.1.2"
