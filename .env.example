# Decibel CLI Environment Variables
# Copy this file to .env and fill in the values

# API wallet private key for signing transactions (hex string starting with 0x)
# Create an API wallet at https://app.decibel.trade/api
# DECIBEL_PRIVATE_KEY=ed25519-priv-0x...

# Subaccount address for trading (hex string starting with 0x)
# This is the address of the Decibel subaccount you're trading on
# DECIBEL_SUBACCOUNT_ADDRESS=0x...

# Account alias from stored accounts (alternative to DECIBEL_PRIVATE_KEY)
# Use this to reference an account added with `decibel-cli account add`
# DECIBEL_ACCOUNT_ALIAS=main

# Network to use: testnet, netna, or local (default: testnet)
DECIBEL_NETWORK=testnet

# Node API key required for API usage (create at https://geomi.dev)
# DECIBEL_NODE_API_KEY=

# Gas station API key for sponsored transactions (create at https://geomi.dev)
# Optional: if not set, your API wallet must have APT for gas fees
# DECIBEL_GAS_STATION_API_KEY=
