# Decibel CLI Configuration
# Private key for trading (hex string starting with 0x)
# Can also use `decibel-cli account add` for secure local storage
DECIBEL_PRIVATE_KEY=

# Network configuration (optional, defaults to testnet)
# Options: testnet, netna, local
DECIBEL_NETWORK=testnet

# Node API key for higher rate limits (optional)
DECIBEL_NODE_API_KEY=

# Gas station API key for sponsored transactions (optional)
DECIBEL_GAS_STATION_API_KEY=
